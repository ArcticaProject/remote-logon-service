#: ../data/remote-logon-service.conf.in.h:1
msgid "Remote Logon"
msgstr "ការចូលពីចម្ងាយ"

#: ../src/main.c:390
msgid ""
"Configuration file for the remote logon service.  Defaults to '/etc/remote-"
"logon-service.conf'."
msgstr ""
"ឯកសារកំណត់រចនាសម្ព័ន្ធសម្រាប់សេវាកម្មចូលពីចម្ងាយ។ លំនាំដើមគឺ '/etc/remote-logon-"
"service.conf'។"

#: ../src/main.c:390
msgid "key_file"
msgstr "ឯកសារកូនសោ"

#: ../src/main.c:415
msgid "- Determine the remote servers that can be logged into"
msgstr "- កំណត់អត្តសញ្ញាណម៉ាស៊ីនបម្រើពីចម្ងាយដែលអាចចូលបាន"
